---
/**
 * Layout for simple Markdown pages such as `src/pages/about.md`.
 *
 * It reads the `title` and `description` from the top of the Markdown file
 * and renders the rest of the file as the page body.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    intro?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <header class="page-header">
    <h1>{frontmatter.title}</h1>
    {frontmatter.intro && <p>{frontmatter.intro}</p>}
  </header>

  <div class="prose">
    <slot />
  </div>
</BaseLayout>
